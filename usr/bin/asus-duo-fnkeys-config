#!/usr/bin/env python3
"""A small settings window for ASUS Zenbook Duo F7-F12 commands."""

import configparser
import os
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gtk


CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "asus-duo" / "fnkeys.conf"
KEYS = ("F7", "F8", "F9", "F10", "F11", "F12")


def load_config():
    config = configparser.ConfigParser()
    config.read(CONFIG_PATH)
    if not config.has_section("settings"):
        config.add_section("settings")
    if not config.has_section("commands"):
        config.add_section("commands")
    if not config.has_option("settings", "enabled"):
        config.set("settings", "enabled", "true")
    return config


def save_config(config):
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    with CONFIG_PATH.open("w", encoding="utf-8") as config_file:
        config.write(config_file)


class FnKeyConfig(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="fi.asus.zenbookduo.fnkeys")
        self.entries = {}

    def do_activate(self):
        config = load_config()
        window = Gtk.ApplicationWindow(application=self, title="ASUS Zenbook Duo function keys")
        window.set_default_size(560, 360)
        window.connect("close-request", self.close_window)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        content.set_margin_top(18)
        content.set_margin_bottom(18)
        content.set_margin_start(18)
        content.set_margin_end(18)
        window.set_child(content)

        instructions = Gtk.Label(
            label="Choose commands for the detachable keyboard's F7-F12 keys. Leave a field blank to keep the normal F-key action."
        )
        instructions.set_wrap(True)
        instructions.set_xalign(0)
        content.append(instructions)

        grid = Gtk.Grid(column_spacing=12, row_spacing=8)
        content.append(grid)
        for row, key in enumerate(KEYS):
            label = Gtk.Label(label=f"{key} command")
            label.set_xalign(1)
            entry = Gtk.Entry()
            entry.set_hexpand(True)
            entry.set_text(config.get("commands", key.lower(), fallback=""))
            grid.attach(label, 0, row, 1, 1)
            grid.attach(entry, 1, row, 1, 1)
            self.entries[key.lower()] = entry

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        actions.set_halign(Gtk.Align.END)
        content.append(actions)

        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda _button: window.close())
        actions.append(cancel)

        save = Gtk.Button(label="Save")
        save.add_css_class("suggested-action")
        save.connect("clicked", self.save, window)
        actions.append(save)

        window.present()

    def close_window(self, _window):
        self.quit()
        return False

    def save(self, _button, window):
        config = load_config()
        for key, entry in self.entries.items():
            config.set("commands", key, entry.get_text().strip())
        save_config(config)
        window.close()


if __name__ == "__main__":
    FnKeyConfig().run()
